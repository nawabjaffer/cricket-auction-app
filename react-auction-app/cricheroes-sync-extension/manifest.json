{
  "manifest_version": 3,
  "name": "CricHeroes Live Sync",
  "version": "2.0",
  "description": "Syncs CricHeroes scores locally to a React app stream overlay.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": [
    "https://*.cricheroes.com/*",
    "https://*.cricheroes.in/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://e-auction-store.web.app/*",
    "https://e-auction-store.firebaseapp.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CricHeroes Live Sync",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.cricheroes.com/*",
        "https://*.cricheroes.in/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://e-auction-store.web.app/*",
        "https://e-auction-store.firebaseapp.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}