{
  "rules": {
    ".read": true,
    ".write": true,
    "auction": {
      "currentState": {
        ".read": true,
        ".write": true
      },
      "mobileBids": {
        ".read": true,
        ".write": true,
        ".indexOn": ["timestamp", "processed"]
      },
      "adminCommands": {
        ".indexOn": ["timestamp", "processed"]
      }
    },
    "tenants": {
      "$tenantId": {
        "auction": {
          "mobileBids": {
            ".indexOn": ["timestamp", "processed"]
          },
          "adminCommands": {
            ".indexOn": ["timestamp", "processed"]
          }
        }
      }
    }
  }
}
